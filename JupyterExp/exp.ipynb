   "source": [
    "def edo(t, T):\n",
    "    \"\"\" dT/dt = k(T-70) \"\"\"\n",
    "    k=math.log(0.5)\n",
    "    return k*(T-70)\n",
    "t0, T0 = 0.0, 80\n",
    "h = 0.2\n",
    "n = 5"
   ]
