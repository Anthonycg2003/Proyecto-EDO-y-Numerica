   "source": [
    "**Plano de fases**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "d7ed2b72-9bfe-446a-ae78-7a430b5d1255",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
